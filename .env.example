# =============================================================================
# SECRETARIA IA — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# NUNCA faça commit do arquivo .env com valores preenchidos
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (banco de dados + autenticação)
# Encontre em: Supabase > Project Settings > API
# -----------------------------------------------------------------------------
SUPABASE_URL=https://seuprojectoaqui.supabase.co
SUPABASE_SERVICE_KEY=eyJ...           # service_role key (acesso total — só no backend)

# -----------------------------------------------------------------------------
# POSTGRESQL DIRETO (usado pelo backend para queries SQL)
# Encontre em: Supabase > Project Settings > Database
# -----------------------------------------------------------------------------
POSTGRES_HOST=db.seuprojectoaqui.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_postgres

# -----------------------------------------------------------------------------
# OPENAI
# Encontre em: platform.openai.com > API Keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# WHATSAPP — Evolution API
# O Evolution API é instalado no mesmo VPS ou em outro servidor
# -----------------------------------------------------------------------------
EVO_BASE_URL=https://seu-servidor-evo.com
EVO_API_KEY=sua_chave_evo_api
EVO_INSTANCE_NAME=secretaria          # Nome da instância criada no Evolution API

# -----------------------------------------------------------------------------
# GOOGLE CALENDAR (agendamento automático)
# Crie uma Service Account em: console.cloud.google.com
# Baixe o JSON e cole o conteúdo abaixo (em uma linha, com \n nos quebras de linha)
# -----------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=secretaria@seu-projeto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# ASAAS (cobranças e pagamentos) — opcional
# Encontre em: Asaas > Integrações > Chave de API
# -----------------------------------------------------------------------------
ASAAS_API_KEY=sua_chave_asaas
ASAAS_WEBHOOK_TOKEN=seu_token_webhook_asaas

# -----------------------------------------------------------------------------
# SERVIDOR
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://SEU_DOMINIO.com  # URL do seu domínio (sem barra no final)

# -----------------------------------------------------------------------------
# FRONTEND — variáveis públicas (prefixo VITE_)
# Estas ficam no .env da pasta raiz do projeto (não do backend)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://seuprojectoaqui.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...         # anon/public key (pode ser exposta no frontend)
VITE_ADMIN_EMAIL=agendanutrijulianamoreira@gmail.com
